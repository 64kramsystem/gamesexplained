 "comments": [
  {
   "address": 24576,
   "type": "line",
   "text": "LEVELF sprite slots for VIC pointers $80\u2013$8F in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 24577,
   "type": "line",
   "text": "The byte at $6001 belongs to the first sprite's 63-byte pattern. The stage loader uses this address for the length high byte before overwriting it with expanded sprite data."
  },
  {
   "address": 25600,
   "type": "line",
   "text": "LEVELF sprite slots for VIC pointers $90\u2013$9F in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 26624,
   "type": "line",
   "text": "LEVELF sprite slots for VIC pointers $A0\u2013$AF in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 27648,
