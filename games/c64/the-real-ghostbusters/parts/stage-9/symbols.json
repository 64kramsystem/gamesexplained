 "comments": [
  {
   "address": 24576,
   "type": "line",
   "text": "LEVELI sprite slots for VIC pointers $80\u2013$8F in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 24577,
   "type": "line",
   "text": "The byte at $6001 belongs to the first sprite's 63-byte pattern. The stage loader uses this address for the length high byte before overwriting it with expanded sprite data."
  },
  {
   "address": 25600,
   "type": "line",
   "text": "LEVELI sprite slots for VIC pointers $90\u2013$9F in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 26624,
   "type": "line",
   "text": "LEVELI sprite slots for VIC pointers $A0\u2013$AF in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 27648,
   "type": "line",
   "text": "LEVELI sprite slots for VIC pointers $B0\u2013$BF in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 28672,
   "type": "line",
   "text": "LEVELI sprite slots for VIC pointers $C0\u2013$CF in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 29696,
   "type": "line",
   "text": "LEVELI sprite slots for VIC pointers $D0\u2013$DB in bank $4000. Each slot has 63 pixel bytes followed by a byte outside the VIC's sprite fetch."
  },
  {
   "address": 30464,
   "type": "line",
   "text": "Translate each of LEVELI's 256 character indices to a colour byte for the viewport renderer at $131B."
  },
  {
   "address": 30720,
   "type": "line",
   "text": "The first 128 glyphs for LEVELI. The IRQ at $0C84 selects the 2 KB character set with $D018 = $0E while VIC bank $4000 is selected."
  },
  {
   "address": 30936,
   "type": "line",
   "text": "The low page of the playfield character set continues here, starting at glyph $1B. The VIC reads eight pattern bytes per glyph."
  },
  {
   "address": 31744,
   "type": "line",
   "text": "LEVELI's glyphs $80-$FF continue the character set at $7800. Each glyph occupies eight bytes."
  },
  {
