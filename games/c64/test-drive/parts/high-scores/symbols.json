 "comments": [
  {
   "address": 59392,
   "type": "line",
   "text": "Relocated entry word $E804 followed by body length $04A3 for HS."
  },
  {
   "address": 59396,
   "type": "line",
   "text": "Preserve the caller argument across the first setup call, then choose a path based on whether A was zero. The final driving path supplies A equal to 1."
  },
  {
   "address": 59408,
   "type": "line",
   "text": "Initialize the DP display mode, set colour RAM to 1 and clear 32 pages of the selected bitmap. For each row of the score list, convert the score into five glyph indices and draw the score and its name."
  },
  {
   "address": 60089,
   "type": "line",
   "text": "Multiply A by eight and add the font base taken from the operand at $EB29. Copy eight bitmap rows to the destination formed with $04xx and $06xx row and column offsets."
  },
  {
   "address": 60167,
   "type": "line",
   "text": "Check four signature bytes at $0700 against $EC93. On a mismatch, request the score record through the descriptor at $EB3E."
  },
  {
   "address": 60196,
   "type": "line",
   "text": "Put mode 2 in A and branch to the shared code that writes the transfer descriptor and invokes $081B."
  },
  {
   "address": 60200,
   "type": "line",
   "text": "Tagged word used as the font pointer by $EACE and $EAD5."
  },
  {
   "address": 60201,
   "type": "line",
   "text": "Low byte of the font base read by the glyph drawing routine."
  },
  {
   "address": 60202,
   "type": "line",
   "text": "High byte of the pointer to $EB4E."
  },
  {
   "address": 60203,
   "type": "line",
   "text": "Tag ahead of the transfer descriptor word."
  },
  {
   "address": 60204,
   "type": "line",
   "text": "Low byte of the transfer descriptor pointer fetched into X."
  },
  {
   "address": 60205,
   "type": "line",
   "text": "High byte of the descriptor pointer fetched into Y."
  },
  {
   "address": 60206,
   "type": "line",
   "text": "Load mode 2 and branch to the same DP call as the mode-one entry."
  },
  {
   "address": 60210,
   "type": "line",
   "text": "Pass mode 1 on entering this entry point, or mode 2 through $EB2E, to DP using the stack."
  },
  {
   "address": 60221,
   "type": "line",
   "text": "A zero byte between the display-mode return and its following transfer descriptor."
  },
  {
   "address": 60222,
   "type": "line",
   "text": "Transfer parameters for the score record, including destination $0700. The pointer at $EB2C supplies its address."
  },
  {
   "address": 60227,
   "type": "line",
   "text": "Set to 1 to load the score record and 2 in the write entry at $EB24."
  },
  {
   "address": 60228,
   "type": "line",
   "text": "Five vertical positions fetched by the score list drawing loop, separated by 40 bitmap row positions."
  },
  {
   "address": 60232,
   "type": "line",
   "text": "The fifth row position is $B8. The score sorter also indexes $EB48 plus X to walk the preceding records when inserting an entry."
  },
  {
   "address": 60233,
   "type": "line",
   "text": "Five offsets into the score record, with a stride of 21 bytes per entry."
  },
  {
   "address": 60238,
   "type": "line",
   "text": "Thirty-eight eight-byte multicolour glyphs. Index 0 is blank, $01-$1A are A to Z, $1B-$24 are 0 through 9, and $25 is a filled cell."
  },
  {
   "address": 60542,
   "type": "line",
   "text": "Eight bitmap rows for glyph $26. The name-entry screen draws this glyph 16 times at $E9FF."
  },
  {
   "address": 60550,
   "type": "line",
   "text": "Two glyph indices alternate between blank and filled under the name-entry cursor. The wait loop toggles its index with EOR #1."
  },
  {
   "address": 60552,
   "type": "line",
   "text": "Low bytes of the five place values repeatedly subtracted when converting a binary score to glyph indices."
  },
  {
   "address": 60557,
   "type": "line",
   "text": "High bytes of the place values paired with $EC88. A score digit becomes a glyph index by adding $1B."
  },
  {
   "address": 60562,
   "type": "line",
   "text": "Rank selected in X at $E999 and used to insert the new score and name into the record."
  },
  {
   "address": 60563,
   "type": "line",
   "text": "Four expected bytes compared with the loaded score buffer at $0700."
  },
  {
   "address": 60567,
   "type": "line",
   "text": "Five glyph indices are written here by the decimal conversion at $E892 before the score is drawn."
  }
 ]
}