 "comments": [
  {
   "address": 40960,
   "type": "line",
   "text": "Copies the common font to $C800, clears the screen and color RAM, installs two overlaid kiwi sprites, sets the text pointers and starts the ending song. After the text scroll it waits for joystick port 2 fire."
  },
  {
   "address": 41222,
   "type": "line",
   "text": "Returns directly from NMI. The epilogue vectors it here while its raster IRQ owns the display."
  },
  {
   "address": 41223,
   "type": "line",
   "text": "Acknowledges the raster interrupt and calls the common SID sequencer, preserving A, X and Y on the stack."
  },
  {
   "address": 41241,
   "type": "line",
   "text": "Sixteen rows of 36 screen codes. $A36F draws them one character at a time, leaving four unused cells per 40-column destination row."
  },
  {
   "address": 41817,
   "type": "line",
   "text": "Nested countdown bytes used by $A35B for the pause between printed characters."
  },
  {
   "address": 41819,
   "type": "line",
   "text": "Spins on two counters in RAM and restores the outer counter to $20 on expiry."
  },
  {
   "address": 41835,
   "type": "line",
   "text": "Draws 16 rows of 36 characters, advancing source by 36 and screen by 40 after each row. Moves both kiwi sprite Y registers down eight lines between rows."
  },
  {
   "address": 41916,
   "type": "line",
   "text": "Two base sprite pointers alternated at $A3C8 to animate the leading kiwi as the text is printed."
  },
  {
   "address": 41918,
   "type": "line",
   "text": "One-bit phase toggled before selecting the next pair of kiwi sprite pointers."
  },
  {
   "address": 41919,
   "type": "line",
   "text": "Alternates base sprite pointers $47 and $49 and uses the succeeding pointer for the second layer. The two sprites share the same position."
  }
 ]
