 "comments": [
  {
   "address": 30720,
   "type": "line",
   "text": "Public entry for $0C5A. Jump to the initial bitmap setup while image tape record 409 is still at $A800."
  },
  {
   "address": 30723,
   "type": "line",
   "text": "Public entry for $0C67 after tape record 428 replaces the preceding image at $A800."
  },
  {
   "address": 30726,
   "type": "line",
   "text": "Entry used by $0C7A. Y receives the saved tick limit from the resident stack."
  },
  {
   "address": 30729,
   "type": "line",
   "text": "Entry for the later bitmap and colour-copy routine at $783A."
  },
  {
   "address": 30732,
   "type": "line",
   "text": "Entry for the last sprite and text setup at $788A."
  },
  {
   "address": 30735,
   "type": "line",
   "text": "Set bitmap mode with screen data at $F000, protect the data at $A480, apply the initial image preparation routines and set the marker at $E000 to zero."
  },
  {
   "address": 30767,
   "type": "line",
   "text": "Repeat the resource preparation at $7993 with the new image in $A800, then run $791E and $78F2 with interrupts masked."
  },
  {
   "address": 30778,
   "type": "line",
   "text": "Disable sprites, prepare image data, then copy $2000 bytes from $8000 into the bitmap at $C000 with I/O banked out. Restore I/O, copy the colour plane and enable sprite zero over the bitmap."
  },
  {
   "address": 30880,
   "type": "line",
   "text": "Write 26 consecutive screen attribute bytes per row, then add 40 to the low operand of the store to move to the next row. This writable operand is labelled separately by Regenerator."
  },
  {
   "address": 30881,
   "type": "line",
   "text": "Low address operand of the screen attribute store at $78A0. $78AC patches it by a screen row after each pass."
  },
  {
   "address": 30910,
   "type": "line",
   "text": "The first 21 bytes written to the sprite at $F800 by $788A. They draw the upper seven three-byte rows of the final overlay."
  },
  {
   "address": 30931,
   "type": "line",
   "text": "Set sprite zero at X $B9, Y $64, white and single colour. Install pointer $E0 at $F7F8 for the sprite data at $F800."
  },
  {
   "address": 30962,
   "type": "line",
