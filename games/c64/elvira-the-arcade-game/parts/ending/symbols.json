 "comments": [
  {
   "address": 5397,
   "type": "line",
   "text": "Saves registers and the processor port, makes I/O visible and acknowledges VIC interrupt flags. For raster IRQs it schedules line $FA, calls the picture sprite setup and the driver at $0884, and increments the tick at $1570."
  },
  {
   "address": 6783,
   "type": "line",
   "text": "Resets the stack, disables CIA interrupts, sets the processor port for RAM with I/O visible, blacks the border and jumps to the ending setup at $12ED."
  },
  {
   "address": 6811,
   "type": "line",
   "text": "Clears zero-page working memory from $02 to $FF."
  },
  {
   "address": 6821,
   "type": "line",
   "text": "Samples input through $1AE4 and $1B21 and loops while both the result at $1AE2 and bit 4 of $1ADF are clear."
  },
  {
   "address": 6840,
   "type": "line",
   "text": "Counts Y down from zero and repeats until the outer X counter reaches zero."
  }
 ]
