 "comments": [
  {
   "address": 5350,
   "type": "line",
   "text": "Clears $07FF and chooses the two-character filename HL or IL according to $13FA. It passes the filename and logical file parameters to the KERNAL and prepares a return into $1800 after LOAD."
  },
  {
   "address": 5406,
   "type": "line",
   "text": "Two consecutive disk filenames. The Fire globe requests HL and the Ice globe requests IL."
  },
  {
   "address": 5412,
   "type": "line",
   "text": "Both words hold $17FF, the return address minus one pushed for the interlude load."
  },
  {
   "address": 5460,
   "type": "line",
   "text": "Sets the RAM IRQ vector to $1585, enables VIC raster interrupts, disables CIA interrupt sources and schedules the first raster comparison."
  },
  {
   "address": 5509,
   "type": "line",
   "text": "Saves registers and brings I/O into view before clearing pending VIC interrupt bits. For a raster interrupt it uses the index at $06 to jump through the table at $15BA."
  },
  {
   "address": 5562,
   "type": "line",
   "text": "Little-endian targets for the two opening raster interrupt stages, $15C3 and $15F2."
  },
  {
   "address": 6905,
   "type": "line",
   "text": "Six fixed-width screen-code labels per language. They cover the two world globes, high scores, the two disk-side prompts and the three difficulty keys."
  },
  {
   "address": 9017,
   "type": "line",
   "text": "Reads the six current score digits in increasing order and stores them in reverse order with the digit character bits set, for comparison with the high score table."
  }
 ]
