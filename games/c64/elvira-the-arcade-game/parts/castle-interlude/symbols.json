 "comments": [
  {
   "address": 2064,
   "type": "line",
   "text": "Requests the world-specific B file through KERNAL LOAD, relocates the resulting pages, then requests the A file and pushes $0811 so LOAD transfers control to $0812 when it returns."
  },
  {
   "address": 2168,
   "type": "line",
   "text": "Contains the side string, the three-character B and A filenames with lengths, and the synthetic LOAD return address minus one."
  },
  {
   "address": 2183,
   "type": "line",
   "text": "With I/O banked out, copies pages backward from $C700 to $FF00 and downward, advancing both high bytes an extra two at the $C9 boundary before continuing."
  },
  {
   "address": 6144,
   "type": "line",
   "text": "Sets the stack, blanks the screen, clears the working zero page and sets up the bitmap and its colour tables. Reads the side marker at $07F2 and branches to the reset path unless its masked value is S."
  },
  {
   "address": 6225,
   "type": "line",
   "text": "Sets the music driver parameter at $08DA to zero, calls its entry at $08DB and then waits on changes in the IRQ state byte at $19A4."
  },
  {
   "address": 6264,
   "type": "line",
   "text": "Selects the KERNAL and I/O with low port bits $06, restores zero page from $C800, hides sprites and disables interrupts before testing the side marker at $07F1."
  },
  {
   "address": 6392,
   "type": "line",
   "text": "Blanks the display, clears the working zero page and several state pages, enables the ROMs and jumps to the KERNAL reset routine."
  },
  {
   "address": 6426,
   "type": "line",
   "text": "Writes the RAM vector for $1945, enables VIC raster interrupts, disables CIA interrupts and schedules the raster comparison at $32."
  },
  {
   "address": 6469,
   "type": "line",
   "text": "Acknowledges VIC raster IRQs and schedules line $32. Bumps the interlude tick and calls $0CDD on odd tick values."
  },
  {
   "address": 7182,
   "type": "line",
   "text": "Sets the stack, clears the CIA interrupt enables, banks the ROMs out with I/O visible, and jumps to the start at $1800."
  },
  {
   "address": 7210,
   "type": "line",
   "text": "Clears zero-page addresses $02-$FF, preserving the processor port at $00-$01."
  },
  {
   "address": 7239,
   "type": "line",
   "text": "Runs an inner 256-decrement Y loop for each outer decrement of X."
  },
  {
   "address": 7248,
   "type": "line",
   "text": "Waits for the low raster byte at $D012 to match X."
  },
  {
   "address": 7254,
   "type": "line",
   "text": "Sets the VIC display-enable bit while clearing the high raster-compare bit."
  },
  {
   "address": 7267,
   "type": "line",
   "text": "Clears VIC display enable and the high raster-compare bit."
  },
  {
   "address": 7283,
   "type": "line",
   "text": "Reads both CIA 1 joystick inputs as active-low masks and combines their five inverted input bits into $1C6E."
  },
  {
   "address": 7497,
   "type": "line",
   "text": "Selects VIC bank $C000, screen matrix $D400 and bitmap $E000. Sets multicolour bitmap mode, sets the border and background to black, and disables sprites."
  },
  {
   "address": 7542,
   "type": "line",
   "text": "Banks I/O out, copies the screen matrix colour-pair bytes from $3DE5 into RAM at $D400, then brings I/O back."
  },
  {
   "address": 7589,
   "type": "line",
   "text": "Copies the four pages from $41E5 into colour RAM and the page at $3C65 into sprite storage starting at $FE80."
  },
  {
   "address": 7625,
   "type": "line",
   "text": "Writes zero to all 32 pages of the bitmap area $E000-$FFFF before drawing the picture."
  },
  {
   "address": 15461,
   "type": "line",
   "text": "A page copied to $FE80 by the same loop that installs the four colour RAM pages."
  },
  {
   "address": 15845,
   "type": "line",
   "text": "The multicolour bitmap screen matrix copied to RAM under I/O at $D400. Each cell byte supplies two colour indices."
  },
  {
   "address": 16869,
   "type": "line",
   "text": "Four pages of cell colour values copied to the colour RAM chip from $D800 through $DBFF."
  }
 ]
}