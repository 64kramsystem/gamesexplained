 "comments": [
  {
   "address": 2066,
   "type": "line",
   "text": "Sets up the title video and interrupts, initializes the music, checks the high score and runs the title loop before dispatching driving file one."
  },
  {
   "address": 2166,
   "type": "line",
   "text": "Selects VIC bank $4000 and $D018=$78 for the title bitmap. Copies four pages from $5800 to colour RAM and selects multicolour bitmap mode."
  },
  {
   "address": 2237,
   "type": "line",
   "text": "Masks CIA interrupts, clears SID volume, disables VIC IRQs and acknowledges latched VIC flags."
  },
  {
   "address": 2996,
   "type": "line",
   "text": "Scans the packed score table in five-byte steps, shifts down lower entries, stores the new score and opens the three-initial editor."
  },
  {
   "address": 3347,
   "type": "line",
   "text": "Writes title IRQ $0D3C and NMI $0E70 into RAM hardware vectors, selects the first title raster handler and enables the VIC raster interrupt."
  },
  {
   "address": 3388,
   "type": "line",
   "text": "Saves A, X and Y in the restore operands, clears decimal mode, acknowledges the VIC raster interrupt and dispatches the title\u2019s changing raster target."
  },
  {
   "address": 3409,
   "type": "line",
   "text": "Sets a common sprite Y, writes X coordinates spaced twenty-four pixels apart, and copies eight pointers to $CFF8 from the table indexed by the title\u2019s four raster rows."
  },
  {
   "address": 3535,
   "type": "line",
   "text": "Advances the title tick, starts the next score row, ticks the music and maps three initial letters plus four BCD digit nibbles from the five-byte records at $0405 into sprite pointers."
  },
  {
   "address": 3840,
   "type": "line",
   "text": "Applies the release\u2019s two title options by patching the alternate music-tick target or title timing instructions, then jumps to $0812."
  },
  {
   "address": 3908,
   "type": "line",
   "text": "Enters the drive wrapper at $0646 with X=2, A=$9A, Y=1 after an eligible score entry. The option at $02B3 bypasses this route."
  },
  {
   "address": 22528,
   "type": "line",
   "text": "Four pages of per-cell colour bytes. $0889 copies this source to $D800 before the title switches to the sprite logo phase."
  },
  {
   "address": 23552,
   "type": "line",
   "text": "Packed colour pairs for the 40-by-25 screen cells in the title bitmap phase. VIC bank $4000 and $D018=$78 address this plane."
  },
  {
   "address": 24576,
   "type": "line",
   "text": "Title bitmap cell rows 1 through 3. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 25536,
   "type": "line",
   "text": "Title bitmap cell rows 4 through 6. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 26496,
   "type": "line",
   "text": "Title bitmap cell rows 7 through 9. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 27456,
   "type": "line",
   "text": "Title bitmap cell rows 10 through 12. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 28416,
   "type": "line",
   "text": "Title bitmap cell rows 13 through 15. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 29376,
   "type": "line",
   "text": "Title bitmap cell rows 16 through 18. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 30336,
   "type": "line",
   "text": "Title bitmap cell rows 19 through 21. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 31296,
   "type": "line",
   "text": "Title bitmap cell rows 22 through 24. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 32256,
   "type": "line",
   "text": "Title bitmap cell rows 25 through 25. Each character row has 320 bytes in pairs-of-pixels multicolour format."
  },
  {
   "address": 45056,
   "type": "line",
   "text": "Jumps to $B131 to clear the title player state and initialize SID."
  },
  {
   "address": 45059,
   "type": "line",
   "text": "Jumps to the music update at $B16C, called by the raster handler."
  },
  {
   "address": 45062,
   "type": "line",
   "text": "Embedded PETSCII text identifies The Fast Lane as Sean Connolly\u2019s title tune and credits him for the music and effects players."
  },
  {
   "address": 53248,
   "type": "line",
   "text": "Low half of the title character image selected by $D018=$34 in VIC bank $C000."
  },
  {
   "address": 54272,
   "type": "line",
   "text": "Upper half of the title character image read by the VIC at the same time that CPU accesses here address SID mirrors."
  }
 ]
}