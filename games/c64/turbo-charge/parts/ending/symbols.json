 "comments": [
  {
   "address": 2066,
   "type": "line",
   "text": "Relocates the picture unpacker to the stack page and low RAM, changes the CPU port and jumps to the unpacker at $0100. The picture paths enter it at $0813."
  },
  {
   "address": 2091,
   "type": "line",
   "text": "Packed Daily Crock newspaper data at package offsets $0019\u2013$0418. The picture unpacker reads these bytes while populating the colour, screen-attribute and bitmap planes."
  },
  {
   "address": 3115,
   "type": "line",
   "text": "Packed Daily Crock newspaper data at package offsets $0419\u2013$0818. The picture unpacker reads these bytes while populating the colour, screen-attribute and bitmap planes."
  },
  {
   "address": 4139,
   "type": "line",
   "text": "Packed Daily Crock newspaper data at package offsets $0819\u2013$0C18. The picture unpacker reads these bytes while populating the colour, screen-attribute and bitmap planes."
  },
  {
   "address": 5163,
   "type": "line",
   "text": "Packed Daily Crock newspaper data at package offsets $0C19\u2013$0FB6. The picture unpacker reads these bytes while populating the colour, screen-attribute and bitmap planes."
  },
  {
   "address": 12096,
   "type": "line",
   "text": "The last 192 bytes in the page-aligned bitmap staging region. The 8,000-byte rendered plane ends at $2F3F. The full-page display copies may transfer part of this zero tail beyond the visible cells."
  },
  {
   "address": 12288,
   "type": "line",
   "text": "Runs the ending setup, resets the stack, clears SID and zero-page state, installs video and interrupt settings, starts the music, then runs the display sequence."
  },
  {
   "address": 12530,
   "type": "line",
   "text": "Uses a picture descriptor and the page copier at $31EE to arrange screen data at $6000, bitmap data at $4000 and colour data at $D800."
  },
  {
   "address": 12599,
   "type": "line",
   "text": "Calls the image selection and expansion routine, copies screen attributes under I/O to $DC00 with $01=$30, restores I/O and copies bitmap rows to $E000. Sets VIC bank $C000 and $D018=$78."
