 "comments": [
  {
   "address": 7680,
   "type": "line",
   "text": "The first copied byte in the scene record is $01. The caller starts executing one byte later."
  },
  {
   "address": 7681,
   "type": "line",
   "text": "Save the caller stack pointer, then set escape $54 and scan the embedded source at $D010 for the end marker. Decode the aligned picture stream to $4000 before setting up the platform scene."
  },
  {
   "address": 7702,
   "type": "line",
   "text": "Read through the banked-out source until eleven bytes match END OF CODE at $1C40."
  },
  {
   "address": 7736,
   "type": "line",
   "text": "Start the graphics stream at the page after the marker. Save the stream pointer at $2D42/$2D43 and decode up to $7FFF exclusive, then clear the padding byte at the end of each 64-byte block in $5000\u2013$75FF."
  },
  {
   "address": 8029,
   "type": "line",
   "text": "Feed alternating synthetic down and left input values to $2116 until sprite 0 X falls below $20."
  },
  {
   "address": 8062,
   "type": "line",
   "text": "Wait through two CIA2 timer periods, then call the descent updates in order. Repeat while $25 is zero and delay the return using $2D33 once it changes."
  },
  {
   "address": 8470,
   "type": "line",
   "text": "Toggle between the sprite pose banks and select the base frame index. Test active-low up, down and horizontal input and use the corresponding four-piece frame tables."
  },
  {
   "address": 9012,
   "type": "line",
   "text": "Skip the update when $2B5E is zero. Otherwise disable the current fire movement, check the descent-distance threshold and update one of two obstacle states."
  },
  {
   "address": 9270,
   "type": "line",
   "text": "Set the mirror flag from A and pass the sprite records in the $A2\u2013$A6 and $AC\u2013$B0 ranges through the shared transform routine. Enable sprites 0\u20134."
  },
  {
   "address": 9572,
   "type": "line",
   "text": "Check the active countdown flag and the platform progress. When it reaches the scene threshold play the alternate screen sequence. Otherwise advance the nested countdowns and handle the timeout path."
  },
  {
   "address": 11588,
   "type": "line",
   "text": "Clear the pending sound effect and cycle four sprite pointers over ten CIA2 waits. Select the fourth display matrix and its colour table for the follow-on animation."
  },
  {
   "address": 12108,
   "type": "line",
   "text": "This scene record ends with the eleven byte marker copied by the unpacker at $0DDE."
  },
  {
   "address": 16384,
   "type": "line",
   "text": "The decoded VIC screen base. The first 256 character indices cover six full rows and the start of the seventh row."
  },
  {
   "address": 16640,
   "type": "line",
   "text": "Screen indices $100\u2013$1FF reference the glyph data at $7800 during the falling platform scene."
  },
  {
   "address": 16896,
   "type": "line",
   "text": "Screen indices $200\u2013$2FF form the lower section of the platform display. The graphics loader puts them here before play begins."
  },
  {
   "address": 17152,
   "type": "line",
   "text": "The last page of falling platform screen memory, with the sprite pointer table occupying the final eight bytes."
  },
  {
   "address": 17408,
   "type": "line",
   "text": "Alternate character matrix at $4400 selected by $D018=$1F. The scene updates cells such as $4531 and $47AD and fills its sprite pointer table at $47F8."
  },
  {
   "address": 18432,
   "type": "line",
   "text": "Third character matrix at $4800. The scene selects it with $D018=$2F and applies the colour lookup with source page $48."
  },
  {
   "address": 19456,
   "type": "line",
   "text": "Fourth character matrix at $4C00 selected by $D018=$3C in the sequence at $2D44. Sprite pointers for this matrix begin at $4FF8."
  },
  {
   "address": 20480,
   "type": "line",
   "text": "The unpacked picture stream initializes $5000\u2013$53FF to zero. These bytes are still zero in the play capture."
  },
  {
   "address": 21504,
   "type": "line",
   "text": "The unpacked picture stream initializes $5400\u2013$57FF to zero. These bytes are still zero in the play capture."
  },
  {
   "address": 22528,
   "type": "line",
   "text": "The first ten sprite frames used as individual pieces for composite movement poses. The rendered pieces include sets of feet, tunic rows and upper body silhouettes."
  },
  {
   "address": 23168,
   "type": "line",
   "text": "Two 64-byte sprite images in slots selected by sprite pointers $6A and $6B. Sprites 2 and 3 selected these slots in the first-descent play capture."
  },
  {
   "address": 23296,
   "type": "line",
   "text": "Two 64-byte sprite records in slots $6C and $6D, selected by sprites 0 and 1 in the first-descent play capture."
  },
  {
   "address": 23424,
   "type": "line",
   "text": "18 adjacent 64-byte records for the middle movement poses. Higher pointers show progressively shifted fragments of feet and body."
  },
  {
   "address": 24576,
   "type": "line",
   "text": "18 64-byte pieces for late platform poses. The bitmaps include outstretched limbs and angled footprints."
  },
  {
   "address": 25728,
   "type": "line",
   "text": "Circular silhouettes and disc quadrants in slots $92\u2013$9C. Shapes $94\u2013$9B are quarter circles of two sizes."
  },
  {
   "address": 26432,
   "type": "line",
   "text": "The unpacked picture stream initializes $6740\u2013$687F to zero. These bytes are still zero in the play capture."
  },
  {
   "address": 26752,
   "type": "line",
   "text": "Sprite records in slots $A2\u2013$B0 showing round and irregular obstacle silhouettes."
  },
  {
   "address": 27712,
   "type": "line",
   "text": "The unpacked picture stream initializes $6C40\u2013$7007 to zero. These bytes are still zero in the play capture."
  },
  {
   "address": 29320,
   "type": "line",
   "text": "The unpacked picture stream initializes $7288\u2013$75FF to zero. These bytes are still zero in the play capture."
  },
  {
   "address": 30208,
   "type": "line",
   "text": "Palette table for the fourth matrix. The scene sets the colour lookup high byte at $167A to $76 before processing the matrix at $4C00."
  },
  {
   "address": 30464,
   "type": "line",
   "text": "Palette table indexed by the active scene character matrix. The descent restores this table before recolouring the first screen."
  },
  {
   "address": 30720,
   "type": "line",
   "text": "The scene character glyph store for VIC bank $4000 and character-base bits 3\u20131 of $D018 set to 7. A character occupies eight consecutive bytes."
  },
  {
   "address": 31744,
   "type": "line",
   "text": "The top half of this scene set, from character code $80. The eight-byte glyph slots are used for the scene-specific objects and screen details."
  }
 ]
